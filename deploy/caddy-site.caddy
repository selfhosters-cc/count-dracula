# The Count Dracula site block for the shared Caddy (LXC 117), v2 ticket 35. deploy/caddy-add-site.sh fills in
# $PUBLIC_HOST and the LXC's address (COUNT_DRACULA_LXC, LXC_IP) from deploy/local.env: the repo names neither.
# Its own site, placed before the wildcard it would fall under: the wildcard's shared log would keep the tokens.
# Expects the shared Caddyfile's dnstls and hsts snippets and its Cloudflare trusted_proxies with
# client_ip_headers CF-Connecting-IP.
# Checked on Caddy 2.11: every token below logs as REDACTED, X-Join-Key isn't logged, a 100 KB POST gets 413,
# and a CF-Connecting-IP from anyone but Cloudflare is replaced by the real peer address.
count-dracula.example.com {
	import dnstls
	import hsts

	request_body {
		max_size 64KB
	}
	reverse_proxy COUNT_DRACULA_LXC:3131 {
		# Other sites' reloads don't cut the TVs' and phones' streams for 10 minutes.
		stream_close_delay 10m
		# The visitor's IP as Caddy worked it out: Cloudflare's header only when Cloudflare sent it.
		header_up CF-Connecting-IP {client_ip}
	}
	# Its own log, 30 days and at most ~500 MB, so Halloween doesn't push the other sites' logs out.
	log {
		output file /var/log/caddy/count-dracula.log {
			roll_size 50MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format filter {
			wrap json
			# A token in the path or the query: the TV link, join keys, Invites, share links, paired TVs, email sign-in links,
			# and the device id a stream counts by.
			request>uri multi_regexp {
				regexp "/tv/k/[^/?#]+" "/tv/k/REDACTED"
				regexp "([?&](?:key|device|deviceId|token)=)[^&#]*" "${1}REDACTED"
			}
			# The same URLs come back as a same-origin Referer.
			request>headers>Referer multi_regexp {
				regexp "/tv/k/[^/?#]+" "/tv/k/REDACTED"
				regexp "([?&](?:key|device|deviceId|token)=)[^&#]*" "${1}REDACTED"
			}
			# The /?key= redirect carries the key on to /door?key= (spec v2.1 §4) in its Location header.
			resp_headers>Location multi_regexp {
				regexp "/tv/k/[^/?#]+" "/tv/k/REDACTED"
				regexp "([?&](?:key|device|deviceId|token)=)[^&#]*" "${1}REDACTED"
			}
			# Phones send their join key as a header.
			request>headers>X-Join-Key delete
		}
	}
}
