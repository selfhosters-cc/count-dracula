[Unit]
Description=Count Dracula (trick-or-treat counter)
After=network-online.target
Wants=network-online.target

[Service]
User=countdracula
Group=countdracula
WorkingDirectory=/opt/count-dracula
ExecStart=/usr/local/bin/bun server/main.js /etc/count-dracula/config.json
# Back in a second if it ever dies (spec §11: "Bun process crash → back in seconds").
Restart=always
RestartSec=1
# The private settings (PUBLIC_HOST, the Google client, OPERATOR_EMAILS, OPERATOR_CONTACT), written by deploy.sh from deploy/local.env. Each Household's time zone is its own,
# so the server's TZ doesn't matter.
EnvironmentFile=/etc/count-dracula/env
# /var/lib/count-dracula, owned by the service user: the SQLite file (WAL) and backups/ live here.
StateDirectory=count-dracula
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
