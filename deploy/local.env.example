# Copy to deploy/local.env (git-ignored) and fill in. deploy.sh writes these into /etc/count-dracula/env on
# the server. Never commit the real values.

# The public host name, behind Cloudflare and the shared Caddy.
PUBLIC_HOST=count-dracula.example.com

# Optional, for caddy-add-site.sh only: hosts that send everything to PUBLIC_HOST with a 301, path and query kept
# (www, a name the site moved from). Each needs its own DNS record. Space-separated.
REDIRECT_HOSTS="www.count-dracula.example.com"

# The Google sign-in client (v2 ticket 20): Google Cloud console → APIs & Services → Credentials.
GOOGLE_CLIENT_ID=1234567890-example.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-example

# Managers whose Google email is here are Operators (/operator). Comma-separated.
OPERATOR_EMAILS=operator@count-dracula.example.com

# The one contact address: /privacy, the Suspended notice and "Help: email us".
OPERATOR_CONTACT=privacy@count-dracula.example.com

# Continue with email (optional): sign-in links sent through a mail service such as Resend (TLS and a login:
# implicit TLS on port 465, STARTTLS on 587), or a LAN relay with plain SMTP on port 25 (leave SMTP_USER and
# SMTP_PASS out). The homepage hides it until SMTP_HOST, EMAIL_FROM and PUBLIC_HOST are all set. EMAIL_FROM's domain is the
# one the service has verified. Quote EMAIL_FROM: it has spaces.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_example
EMAIL_FROM="Count Dracula <sign-in@count-dracula.example.com>"

# Our LAN, used only by the deploy scripts on this machine (never sent to the server, never committed):
# create-lxc.sh makes the LXC at LXC_IP, caddy-add-site.sh points the shared Caddy (at CADDY_IP) at it.
LXC_IP=192.0.2.31
LXC_GATEWAY=192.0.2.1
CADDY_IP=192.0.2.20
