# Copy to .env next to compose.yaml (git ignores it) and fill in.

# The public host name people open, served over HTTPS (Google sign-in needs it).
PUBLIC_HOST=count-dracula.example.com

# Google sign-in: Google Cloud console → Google Auth Platform → Clients → a "Web application" client with the
# redirect URI https://<PUBLIC_HOST>/auth/google/callback.
GOOGLE_CLIENT_ID=1234567890-example.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-example

# Whoever signs in with one of these emails also gets /operator, the whole-site dashboard. Comma-separated.
OPERATOR_EMAILS=you@example.com

# The one contact address shown on /privacy and "Help: email us".
OPERATOR_CONTACT=you@example.com

# Optional: Continue with email (a sign-in link) through an SMTP server. A mail service such as Resend: its host,
# port 465 (implicit TLS) or 587 (STARTTLS), and its login. A relay on your network with no TLS or login: port 25,
# SMTP_USER and SMTP_PASS empty. Leave SMTP_HOST empty to hide it. It stays off without PUBLIC_HOST above: the
# emailed links open that host. Quote EMAIL_FROM: it has spaces.
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Count Dracula <sign-in@count-dracula.example.com>"

# Optional: where the app listens on the host (default 127.0.0.1:3131). Use COUNT_DRACULA_BIND=0.0.0.0 only for
# a proxy on another machine, and have that proxy set CF-Connecting-IP to the visitor's address.
# COUNT_DRACULA_BIND=127.0.0.1
# COUNT_DRACULA_PORT=3131

# Optional: who may set CF-Connecting-IP. Unset, a proxy on this machine or a private network (the bundled Caddy, a
# Docker network, your LAN or tailnet). Set it, as addresses or CIDR ranges, only for a proxy that reaches the app
# from a public address.
# TRUSTED_PROXIES=203.0.113.10, 2001:db8::/64
